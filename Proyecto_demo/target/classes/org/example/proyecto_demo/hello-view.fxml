<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.proyecto_demo.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label styleClass="heading" text="LOGIN CLUB DE PÁDEL" />

    <VBox maxWidth="250.0" spacing="10.0">
        <TextField fx:id="txtEmail" promptText="Email" />
        <PasswordField fx:id="txtPassword" promptText="Contraseña" />
    </VBox>

    <Button maxWidth="250.0" onAction="#onLoginButtonClick" styleClass="my-button" text="Entrar" />

    <Button onAction="#onIrARegistroClick" styleClass="link-button" text="¿No tienes cuenta? Regístrate" />

    <Label fx:id="mensajeError" styleClass="my-error-text" />
</VBox>